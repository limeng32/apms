# APMS-AI 生产构建（vite build --mode ai）
# 页面标题
VITE_APP_TITLE = 运动员训练数据管理系统

VITE_APP_ENV = 'production'

# 生产环境 API 地址（Nginx 反代 /prod-api 到后端 8080）
VITE_APP_BASE_API = '/prod-api'

# 产品线：ai 构建包含 AI 插件容器与已注册插件（@ai 别名解析到 src/ai）
VITE_EDITION = ai

# 品牌展示入口域名（逗号分隔）：命中这些 hostname 时只渲染展示落地页。
# 默认 www.apms.top 与裸域 apms.top（硬编码在 utils/entry.js），一般无需配置；仅在需要更换/新增展示域名时覆盖。
# VITE_SHOWCASE_HOSTS = 'www.apms.top,apms.top'
