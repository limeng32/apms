# APMS-Standard 生产构建（vite build --mode standard）
# 页面标题
VITE_APP_TITLE = 运动员训练数据管理系统

VITE_APP_ENV = 'production'

# 生产环境 API 地址（Nginx 反代 /prod-api 到后端 8080）
VITE_APP_BASE_API = '/prod-api'

# 产品线：standard 构建零 AI 代码（@ai 别名解析到 src/ai-stub）
VITE_EDITION = standard

# 同域演示站入口（Edition 无关，standard/ai 配同值）：
# 配置后登录页「一键体验」noopener 新开该 URL（演示站固定 AI 全量），并隐藏原地口令演示；
# 留空/不配置（本地 dev、UAT）则保持现有原地口令演示，行为不变。
# VITE_TRIAL_URL = 'https://aoti.apms.top/trial/'
