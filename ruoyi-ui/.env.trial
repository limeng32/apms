# APMS 同域演示站构建（vite build --mode trial）
# 与正式部署 Edition（standard/ai）完全无关：本包固定 AI 全量代码，
# 部署在同域 /trial/ 子路径，带演示锁定（8888 口令进入，零真实请求）。

# 页面标题
VITE_APP_TITLE = 运动员训练数据管理系统（演示环境）

VITE_APP_ENV = 'production'

# API 兜底值；演示态全链路由 demoAdapter 本地闭环，实际不会发出真实请求
VITE_APP_BASE_API = '/prod-api'

# 产品线：trial 固定包含 AI 插件容器与全部插件（@ai 别名解析到 src/ai）
VITE_EDITION = ai

# Vite 部署 base：子路径 /trial/，喂给 vite.config 与 vue-router
VITE_APP_BASEPATH = '/trial/'

# 独立输出目录，绝不覆盖正式构建（standard/ai 均输出 dist）
VITE_BUILD_OUTDIR = 'dist-trial'

# 演示锁定：隐藏真实登录表单，只留口令入口；auth 三函数/路由闸门/请求短路均据此常量收口
VITE_DEMO_LOCKED = 'true'

# 演示口令（沿用现有机制，可按需覆盖）
VITE_DEMO_PASSCODE = '8888'
