<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.apms.ApmsIndicatorRefLevelMapper">

    <resultMap id="ApmsIndicatorRefLevelResult" type="com.ruoyi.system.domain.apms.ApmsIndicatorRefLevel">
        <id     column="id"        property="id"/>
        <result column="ref_id"    property="refId"/>
        <result column="level"     property="level"/>
        <result column="min_value" property="minValue"/>
        <result column="max_value" property="maxValue"/>
    </resultMap>

    <select id="selectByRefId" parameterType="Long" resultMap="ApmsIndicatorRefLevelResult">
        SELECT id, ref_id, level, min_value, max_value
        FROM apms_indicator_ref_level
        WHERE ref_id = #{refId}
        ORDER BY CASE level WHEN 'ATTENTION' THEN 0 WHEN 'NORMAL' THEN 1 WHEN 'GOOD' THEN 2 ELSE 3 END
    </select>

    <select id="selectById" parameterType="Long" resultMap="ApmsIndicatorRefLevelResult">
        SELECT id, ref_id, level, min_value, max_value FROM apms_indicator_ref_level WHERE id = #{id}
    </select>

    <insert id="insert" parameterType="com.ruoyi.system.domain.apms.ApmsIndicatorRefLevel" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO apms_indicator_ref_level (ref_id, level, min_value, max_value)
        VALUES (#{refId}, #{level}, #{minValue}, #{maxValue})
    </insert>

    <update id="update" parameterType="com.ruoyi.system.domain.apms.ApmsIndicatorRefLevel">
        UPDATE apms_indicator_ref_level
        SET min_value = #{minValue}, max_value = #{maxValue}
        WHERE id = #{id}
    </update>

    <delete id="deleteById" parameterType="Long">
        DELETE FROM apms_indicator_ref_level WHERE id = #{id}
    </delete>

    <delete id="deleteByRefId" parameterType="Long">
        DELETE FROM apms_indicator_ref_level WHERE ref_id = #{refId}
    </delete>

</mapper>
