<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.apms.ApmsMedicalFileMapper">

    <resultMap id="ApmsMedicalFileResult" type="com.ruoyi.system.domain.apms.ApmsMedicalFile">
        <id     column="id"          property="id"/>
        <result column="record_id"   property="recordId"/>
        <result column="file_name"   property="fileName"/>
        <result column="file_path"   property="filePath"/>
        <result column="file_size"   property="fileSize"/>
        <result column="file_ext"    property="fileExt"/>
        <result column="upload_by"   property="uploadBy"/>
        <result column="upload_time" property="uploadTime"/>
    </resultMap>

    <select id="selectById" parameterType="Long" resultMap="ApmsMedicalFileResult">
        SELECT * FROM apms_medical_file WHERE id = #{id}
    </select>

    <select id="selectByRecordId" parameterType="Long" resultMap="ApmsMedicalFileResult">
        SELECT * FROM apms_medical_file WHERE record_id = #{recordId} ORDER BY id
    </select>

    <insert id="insert" parameterType="com.ruoyi.system.domain.apms.ApmsMedicalFile" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO apms_medical_file (record_id, file_name, file_path, file_size, file_ext, upload_by, upload_time)
        VALUES (#{recordId}, #{fileName}, #{filePath}, #{fileSize}, #{fileExt}, #{uploadBy}, NOW())
    </insert>

    <delete id="deleteById"><![CDATA[DELETE FROM apms_medical_file WHERE id = #{id}]]></delete>
    <delete id="deleteByRecordId"><![CDATA[DELETE FROM apms_medical_file WHERE record_id = #{recordId}]]></delete>
</mapper>
