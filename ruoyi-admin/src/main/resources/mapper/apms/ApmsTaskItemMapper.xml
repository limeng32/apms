<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.apms.ApmsTaskItemMapper">

    <resultMap id="ApmsTaskItemResult" type="com.ruoyi.system.domain.apms.ApmsTaskItem">
        <id     column="ti_id"           property="id"/>
        <result column="task_id"          property="taskId"/>
        <result column="item_type"        property="itemType"/>
        <result column="indicator_id"     property="indicatorId"/>
        <result column="model_id"         property="modelId"/>
        <result column="is_required"      property="isRequired"/>
        <result column="sort_order"       property="sortOrder"/>
        <!-- JOIN indicator -->
        <result column="ind_code"         property="indicatorCode"/>
        <result column="ind_name"         property="indicatorName"/>
        <result column="ind_direction"    property="indicatorDirection"/>
        <!-- JOIN test_model -->
        <result column="tm_code"          property="modelCode"/>
        <result column="tm_name"          property="modelName"/>
        <result column="tm_category"      property="modelCategory"/>
    </resultMap>

    <sql id="selectVo">
        SELECT ti.id AS ti_id, ti.task_id, ti.item_type, ti.indicator_id, ti.model_id,
               ti.is_required, ti.sort_order,
               ind.code  AS ind_code,  ind.name AS ind_name, ind.evaluation_direction AS ind_direction,
               tm.code   AS tm_code,   tm.name  AS tm_name,  tm.category AS tm_category
        FROM apms_task_item ti
        LEFT JOIN apms_indicator ind  ON ti.indicator_id = ind.id
        LEFT JOIN apms_test_model tm ON ti.model_id    = tm.id
    </sql>

    <select id="selectByTaskId" parameterType="Long" resultMap="ApmsTaskItemResult">
        <include refid="selectVo"/>
        WHERE ti.task_id = #{taskId}
        ORDER BY ti.sort_order ASC, ti.id ASC
    </select>

    <select id="selectById" parameterType="Long" resultMap="ApmsTaskItemResult">
        <include refid="selectVo"/> WHERE ti.id = #{id}
    </select>

    <insert id="insert" parameterType="com.ruoyi.system.domain.apms.ApmsTaskItem" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO apms_task_item (task_id, item_type, indicator_id, model_id, is_required, sort_order)
        VALUES (#{taskId}, #{itemType}, #{indicatorId}, #{modelId}, #{isRequired}, #{sortOrder})
    </insert>

    <update id="update" parameterType="com.ruoyi.system.domain.apms.ApmsTaskItem">
        UPDATE apms_task_item
        SET item_type = #{itemType}, indicator_id = #{indicatorId}, model_id = #{modelId},
            is_required = #{isRequired}, sort_order = #{sortOrder}
        WHERE id = #{id}
    </update>

    <delete id="deleteById" parameterType="Long">
        DELETE FROM apms_task_item WHERE id = #{id}
    </delete>

    <delete id="deleteByTaskId" parameterType="Long">
        DELETE FROM apms_task_item WHERE task_id = #{taskId}
    </delete>

</mapper>
