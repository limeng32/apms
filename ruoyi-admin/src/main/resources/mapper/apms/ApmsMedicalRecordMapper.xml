<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.apms.ApmsMedicalRecordMapper">

    <resultMap id="ApmsMedicalRecordResult" type="com.ruoyi.system.domain.apms.ApmsMedicalRecord">
        <id     column="id"            property="id"/>
        <result column="athlete_id"    property="athleteId"/>
        <result column="record_type"   property="recordType"/>
        <result column="record_date"   property="recordDate"/>
        <result column="institution"   property="institution"/>
        <result column="title"         property="title"/>
        <result column="remark"        property="remark"/>
        <result column="create_by"     property="createBy"/>
        <result column="create_time"   property="createTime"/>

        <!-- JOIN 解析 -->
        <result column="a_name"        property="athleteName"/>
        <result column="a_gender"      property="athleteGender"/>
        <result column="dept_name"     property="athleteTeam"/>
    </resultMap>

    <sql id="selectVo">
        SELECT r.id, r.athlete_id, r.record_type, r.record_date, r.institution,
               r.title, r.remark, r.create_by, r.create_time,
               a.name AS a_name, a.gender AS a_gender, d.dept_name
        FROM apms_medical_record r
        LEFT JOIN apms_athlete a ON r.athlete_id = a.athlete_id
        LEFT JOIN sys_dept d     ON a.primary_team_id = d.dept_id
    </sql>

    <select id="selectById" parameterType="Long" resultMap="ApmsMedicalRecordResult">
        <include refid="selectVo"/> WHERE r.id = #{id}
    </select>

    <select id="selectList" parameterType="com.ruoyi.system.domain.apms.ApmsMedicalRecord" resultMap="ApmsMedicalRecordResult">
        <include refid="selectVo"/>
        <where>
            <if test="athleteId != null">  AND r.athlete_id = #{athleteId}</if>
            <if test="recordType != null and recordType != ''"> AND r.record_type = #{recordType}</if>
            <if test="recordDate != null"> AND r.record_date = #{recordDate}</if>
            <if test="params.dataScope != null and params.dataScope != ''">
                AND ${params.dataScope}
            </if>
        </where>
        ORDER BY r.record_date DESC, r.id DESC
    </select>

    <insert id="insert" parameterType="com.ruoyi.system.domain.apms.ApmsMedicalRecord" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO apms_medical_record (athlete_id, record_type, record_date, institution, title, remark, create_by, create_time)
        VALUES (#{athleteId}, #{recordType}, #{recordDate}, #{institution}, #{title}, #{remark}, #{createBy}, NOW())
    </insert>

    <update id="update" parameterType="com.ruoyi.system.domain.apms.ApmsMedicalRecord">
        UPDATE apms_medical_record
        SET athlete_id=#{athleteId}, record_type=#{recordType}, record_date=#{recordDate},
            institution=#{institution}, title=#{title}, remark=#{remark}
        WHERE id=#{id}
    </update>

    <delete id="deleteById"><![CDATA[DELETE FROM apms_medical_record WHERE id = #{id}]]></delete>
    <delete id="deleteByAthleteId"><![CDATA[DELETE FROM apms_medical_record WHERE athlete_id = #{athleteId}]]></delete>
</mapper>
