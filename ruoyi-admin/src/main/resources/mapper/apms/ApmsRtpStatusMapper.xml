<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.apms.ApmsRtpStatusMapper">

    <resultMap id="ApmsRtpStatusResult" type="com.ruoyi.system.domain.apms.ApmsRtpStatus">
        <id     property="id"             column="id"/>
        <result property="athleteId"      column="athlete_id"/>
        <result property="status"         column="status"/>
        <result property="reason"         column="reason"/>
        <result property="trainingLimit"  column="training_limit"/>
        <result property="nextReviewDate" column="next_review_date"/>
        <result property="updatedBy"      column="updated_by"/>
        <result property="updatedTime"    column="updated_time"/>
        <result property="athleteName"    column="athlete_name"/>
    </resultMap>

    <sql id="selectApmsRtpStatusVo">
        SELECT
            s.id, s.athlete_id, s.status, s.reason, s.training_limit,
            s.next_review_date, s.updated_by, s.updated_time,
            a.name AS athlete_name
        FROM apms_rtp_status s
        LEFT JOIN apms_athlete a ON s.athlete_id = a.athlete_id
    </sql>

    <select id="selectByAthleteId" parameterType="Long" resultMap="ApmsRtpStatusResult">
        <include refid="selectApmsRtpStatusVo"/>
        WHERE s.athlete_id = #{athleteId}
    </select>

    <select id="selectList" resultMap="ApmsRtpStatusResult">
        <include refid="selectApmsRtpStatusVo"/>
        ORDER BY s.updated_time DESC
    </select>

    <insert id="insert" parameterType="com.ruoyi.system.domain.apms.ApmsRtpStatus" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO apms_rtp_status (
            athlete_id, status, reason, training_limit, next_review_date,
            updated_by, updated_time
        ) VALUES (
            #{athleteId}, #{status}, #{reason}, #{trainingLimit}, #{nextReviewDate},
            #{updatedBy}, sysdate()
        )
    </insert>

    <update id="update" parameterType="com.ruoyi.system.domain.apms.ApmsRtpStatus">
        UPDATE apms_rtp_status
        <set>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="reason != null">reason = #{reason},</if>
            <if test="trainingLimit != null">training_limit = #{trainingLimit},</if>
            <if test="nextReviewDate != null">next_review_date = #{nextReviewDate},</if>
            <if test="updatedBy != null and updatedBy != ''">updated_by = #{updatedBy},</if>
            updated_time = sysdate()
        </set>
        WHERE id = #{id}
    </update>

    <delete id="deleteByAthleteId" parameterType="Long">
        DELETE FROM apms_rtp_status WHERE athlete_id = #{athleteId}
    </delete>

</mapper>
