# =====================================================================
# 同域演示站 /trial/ 的 nginx 增量配置（人工部署，Agent 不代发）
# ---------------------------------------------------------------------
# 前置条件：
#   1. 已执行 bash deploy/build.sh --edition trial，
#      产物经独立 rsync 落在 /opt/apms/frontend/trial-dist/（与正式 dist 并列）；
#   2. 将下方 location 块放入 apms-nginx.conf 中 aoti.apms.top 的 **443 server 块**
#      （80 块只做 301 跳 HTTPS，无需改动；HTTP 访问 /trial/ 会随全站跳转自动升级）。
#
# 关键：必须用 ^~ 前缀。server 级存在静态资源正则 location
# （~* \.(js|css|png...)$，expires 7d），普通前缀 location /trial/ 优先级低于正则，
# /trial/static/js/*.js 会被正则块按 server root 解析到正式 dist 而 404；
# ^~ 命中后跳过正则匹配，保证全部子路径走本 alias。
#
# 演示态零真实后端请求（demoAdapter 本地闭环 + 锁定短路），因此本块**不需要**反代 /prod-api。
# =====================================================================

location ^~ /trial/ {
    alias /opt/apms/frontend/trial-dist/;
    index index.html;
    try_files $uri $uri/ /trial/index.html;

    # 与主站一致的压缩策略
    gzip on;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml text/javascript image/svg+xml application/xml+rss application/vnd.ms-fontobject application/x-font-ttf font/opentype;
    gzip_min_length 1024;
    gzip_comp_level 6;

    # 带内容哈希的构建产物可长缓存；index.html 不缓存，保证发版后入口即时更新
    location ~* ^/trial/static/ {
        expires 7d;
        access_log off;
    }
    location = /trial/index.html {
        add_header Cache-Control "no-cache, no-store, must-revalidate";
    }
}

# ---------------------------------------------------------------------
# 可选加固（评审决定，默认不加）：
#   demo 包本就含全量 AI 源码且无真实数据/接口，不加也不泄露业务数据。
#
# 方案 A：HTTP Basic 口令（与前端 8888 口令相互独立，双层门）
#   location ^~ /trial/ {
#       auth_basic "APMS Trial";
#       auth_basic_user_file /etc/nginx/.apms_trial_htpasswd;
#       ...其余同上...
#   }
#
# 方案 B：IP 白名单
#   location ^~ /trial/ {
#       allow 10.0.0.0/8;
#       allow 192.168.0.0/16;
#       deny all;
#       ...其余同上...
#   }
#
# 变更后执行：nginx -t && nginx -s reload
# 回滚：删除本 location 块并 reload，再 rm -rf /opt/apms/frontend/trial-dist/，正式站零影响。
# =====================================================================
