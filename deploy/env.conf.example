# =====================================================================
# APMS 生产环境配置
# ---------------------------------------------------------------------
# 放置路径: /etc/apms/env.conf
# 权限设置: chmod 600 /etc/apms/env.conf
# deploy.sh 会优先 source 这个文件，找不到才用脚本内的默认值
# =====================================================================

# ---- MySQL ----
DB_HOST="localhost"
DB_PORT="3306"
DB_NAME="ry-vue"
DB_USER="root"
# ⚠️ 密码里如果有 !#$ 等特殊字符，deploy.sh 已用函数形式处理，这里直接写即可
DB_PASS="!#111111qQ"

# ---- Redis ----
REDIS_HOST="localhost"
REDIS_PORT="6379"
REDIS_PASS=""          # 如果有密码，填这里

# ---- 路径 ----
BINDIR="/opt/apms"
PUBLIC_HOST="39.97.246.69"
