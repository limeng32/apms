# =====================================================================
# APMS 部署环境配置
# ---------------------------------------------------------------------
# 生产: /etc/apms/env.conf           chmod 600  ⚠️ 必须
# UAT:  /opt/apms-uat/env.conf       chmod 600  ⚠️ 必须
# deploy.sh / deploy-uat.sh 会 source 这个文件
# deploy.sh (prod) 缺失此文件会 hard fail，不会 fallback
# =====================================================================

# ---- Spring Profile + 端口 ----
PROFILE="prod"
APP_PORT="10080"        # 业务 API 端口（server.port）
MGMT_PORT="10081"       # Actuator 健康检查端口（management.server.port）

# ---- MySQL（用单独业务账号，绝对不要用 root）----
DB_HOST="localhost"
DB_PORT="3306"
DB_NAME="apms"
DB_USER="apms_app"
# ⚠️ 密码里如果有 !#$ 等特殊字符，deploy.sh 已用函数形式处理，这里直接写即可
DB_PASS="<YOUR_DB_PASSWORD>"

# ---- Redis ----
REDIS_HOST="localhost"
REDIS_PORT="6379"
REDIS_PASS=""           # 如果有密码，填这里；无密码也要显式声明
REDIS_DB="0"            # DB index: prod 用 0, uat 用 1

# ---- 路径 ----
BINDIR="/opt/apms"
PUBLIC_HOST="<YOUR_SERVER_IP>"

# =====================================================================
# MySQL 安全配置（一次性执行，数据库层面）：
#   CREATE USER 'apms_app'@'localhost' IDENTIFIED BY '<strong-password>';
#   GRANT ALL PRIVILEGES ON apms.* TO 'apms_app'@'localhost';
#   FLUSH PRIVILEGES;
# =====================================================================
