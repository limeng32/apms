# =====================================================================
# APMS 部署环境配置
# ---------------------------------------------------------------------
# 生产: /etc/apms/env.conf           chmod 600
# UAT:  /opt/apms-uat/env.conf       chmod 600
# deploy.sh / deploy-uat.sh 会 source 这个文件
# =====================================================================

# ---- Spring Profile + 端口 ----
# dev:  --spring.profiles.active=druid (默认)
# uat:  --spring.profiles.active=uat
# prod: --spring.profiles.active=prod
PROFILE="prod"
APP_PORT="10080"        # 业务 API 端口（server.port）
MGMT_PORT="10081"       # Actuator 健康检查端口（management.server.port）

# ---- MySQL ----
DB_HOST="localhost"
DB_PORT="3306"
DB_NAME="ry-vue"
DB_USER="root"
# ⚠️ 密码里如果有 !#$ 等特殊字符，deploy.sh 已用函数形式处理，这里直接写即可
DB_PASS="!#111111qQ"

# ---- Redis ----
REDIS_HOST="localhost"
REDIS_PORT="6379"
REDIS_PASS=""           # 如果有密码，填这里
REDIS_DB="0"            # DB index: prod 用 0, uat 用 1

# ---- 路径 ----
BINDIR="/opt/apms"
PUBLIC_HOST="39.97.246.69"
